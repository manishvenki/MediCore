# ==========================================
# MediCore Server Environment Configuration
# ==========================================

# Server Runtime Environment (development | production)
NODE_ENV=development

# Server HTTP Port (Default: 5000)
PORT=5000

# MongoDB Connection URI:
# - Local Development: mongodb://localhost:27017/medicore (or leave blank for embedded memory DB fallback)
# - Production: MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medicore

# JSON Web Token Secret Key (Required)
# In production, provide a strong random 256-bit alphanumeric string
JWT_SECRET=medicore_super_secret_jwt_key_2026_demo

# Frontend Client URL for CORS policy
# In production, set this to your deployed frontend domain (e.g., https://app.yourdomain.com)
# Supports comma-separated list of origins or wildcard '*'
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
