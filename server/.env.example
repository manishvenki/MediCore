# ==========================================
# MediCore Server Environment Configuration
# ==========================================

# Server Runtime Environment (development | production)
NODE_ENV=development

# Server Port (Used for local standalone execution; automatically handled by Vercel in serverless)
PORT=5000

# MongoDB Connection String:
# - For Local Development: mongodb://localhost:27017/medicore (or leave blank for embedded memory DB fallback)
# - For Vercel Production: Standard MongoDB Atlas SRV URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medicore

# JSON Web Token Secret (Required)
# In production on Vercel, generate a strong random 256-bit alphanumeric string
JWT_SECRET=medicore_super_secret_jwt_key_2026_demo

# Frontend Client URL for CORS policy
# In production on Vercel, set this to your deployed frontend domain (e.g., https://your-medicore-frontend.vercel.app)
# Supports comma-separated list of origins or wildcard '*'
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
